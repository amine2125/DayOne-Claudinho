# Vonage Messages API (canal WhatsApp) — Dashboard Vonage, page « API Settings »
VONAGE_API_KEY=votre_api_key
VONAGE_API_SECRET=votre_api_secret
# « Signature secret », même page : vérifie que les webhooks viennent bien de Vonage (obligatoire)
VONAGE_SIGNATURE_SECRET=votre_signature_secret
# Numéro WhatsApp Business relié à l'application Vonage, ou numéro du sandbox (sans « + »)
VONAGE_WHATSAPP_NUMBER=14157386102
# true : envoi par le sandbox (messages-sandbox.nexmo.com) ; false : production (api.nexmo.com)
VONAGE_SANDBOX=true
# Adresse publique de ce bot (la même que celle des webhooks, ex. https://xxxx.trycloudflare.com) :
# Vonage y récupère la fiche PDF envoyée à la sage-femme. Vide : un texte renvoie au tableau de bord.
PUBLIC_BASE_URL=

# Clé du HMAC qui identifie la sage-femme sans son numéro : la changer change ses identifiants
MIDWIFE_ID_SECRET=choisir_une_longue_valeur_aleatoire

# API DayOne (api/main.py) : lecture, base des dossiers, tableau de bord
DAYONE_API_URL=http://localhost:8000
OUR_API_KEY=
READ_TIMEOUT_PER_PAGE=300

# Configuration serveur (8000 est pris par l API DayOne)
HOST=0.0.0.0
PORT=8001
